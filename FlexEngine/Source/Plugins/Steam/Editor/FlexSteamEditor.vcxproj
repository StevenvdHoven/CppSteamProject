<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemGroup Label="ProjectConfigurations">
		<ProjectConfiguration Include="Debug|x64">
			<Configuration>Debug</Configuration>
			<Platform>x64</Platform>
		</ProjectConfiguration>
		<ProjectConfiguration Include="Development|x64">
			<Configuration>Development</Configuration>
			<Platform>x64</Platform>
		</ProjectConfiguration>
		<!-- Only here so the solution can map it; the solution does not build editor plugins in Shipping. -->
		<ProjectConfiguration Include="Shipping|x64">
			<Configuration>Shipping</Configuration>
			<Platform>x64</Platform>
		</ProjectConfiguration>
	</ItemGroup>

	<PropertyGroup Label="Globals">
		<VCProjectVersion>18.0</VCProjectVersion>
		<ProjectGuid>{6441093B-2655-488F-A3CE-B48A001DA7EE}</ProjectGuid>
		<RootNamespace>FlexSteamEditor</RootNamespace>
		<WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
	</PropertyGroup>

	<!-- The Steam plugin's editor part: Binaries/<Config>/Plugins/FlexSteamEditor.dll (the runtime part is FlexSteam.dll). -->
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
	<Import Project="..\..\..\..\Build\FlexConfiguration.props" />
	<PropertyGroup Label="Configuration">
		<ConfigurationType>DynamicLibrary</ConfigurationType>
	</PropertyGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
	<ImportGroup Label="PropertySheets">
		<Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
		<Import Project="..\..\..\..\Build\FlexCommon.props" />
		<Import Project="..\..\..\..\Build\FlexEditorPlugin.props" />
	</ImportGroup>

	<ItemGroup>
		<ClInclude Include="SteamPanel.h" />
	</ItemGroup>
	<ItemGroup>
		<ClCompile Include="SteamEditorPlugin.cpp" />
		<ClCompile Include="SteamPanel.cpp" />
	</ItemGroup>

	<!-- Build order only: FlexEditorPlugin.props links the editor's import libraries, FlexSteam.lib comes
	     from the #pragma in Plugins/Steam/Runtime/SteamApi.h. -->
	<ItemGroup>
		<ProjectReference Include="..\..\..\Core\FlexCore.vcxproj">
			<Project>{09E204DC-F3FB-49AB-8B40-00F95CE22909}</Project>
			<LinkLibraryDependencies>false</LinkLibraryDependencies>
		</ProjectReference>
		<ProjectReference Include="..\..\..\Editor\FlexEditorCore.vcxproj">
			<Project>{8A4AF817-6CAD-42FA-A025-314B16617063}</Project>
			<LinkLibraryDependencies>false</LinkLibraryDependencies>
		</ProjectReference>
		<ProjectReference Include="..\Runtime\FlexSteam.vcxproj">
			<Project>{63CABDE1-65D8-4DDC-B0FC-6008DC7E3A1E}</Project>
			<LinkLibraryDependencies>false</LinkLibraryDependencies>
		</ProjectReference>
	</ItemGroup>

	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
