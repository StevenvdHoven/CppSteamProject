<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemGroup Label="ProjectConfigurations">
		<ProjectConfiguration Include="Debug|x64">
			<Configuration>Debug</Configuration>
			<Platform>x64</Platform>
		</ProjectConfiguration>
		<ProjectConfiguration Include="Development|x64">
			<Configuration>Development</Configuration>
			<Platform>x64</Platform>
		</ProjectConfiguration>
		<!-- Only here so the solution can map it; the solution does not build the editor in Shipping. -->
		<ProjectConfiguration Include="Shipping|x64">
			<Configuration>Shipping</Configuration>
			<Platform>x64</Platform>
		</ProjectConfiguration>
	</ItemGroup>

	<PropertyGroup Label="Globals">
		<VCProjectVersion>18.0</VCProjectVersion>
		<ProjectGuid>{A04C3F5A-86B9-4F2F-BF43-8C01C395BF67}</ProjectGuid>
		<RootNamespace>FlexEditor</RootNamespace>
		<WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
	</PropertyGroup>

	<!-- FlexEditor.exe: only starts the editor in FlexEditorCore.dll (RunEditor). -->
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
	<Import Project="..\..\Build\FlexConfiguration.props" />
	<PropertyGroup Label="Configuration">
		<ConfigurationType>Application</ConfigurationType>
	</PropertyGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
	<ImportGroup Label="PropertySheets">
		<Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
		<Import Project="..\..\Build\FlexCommon.props" />
	</ImportGroup>

	<ItemDefinitionGroup>
		<ClCompile>
			<PreprocessorDefinitions>FLEX_EDITOR=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<Link>
			<SubSystem>Console</SubSystem>
			<AdditionalDependencies>SDL3.lib;%(AdditionalDependencies)</AdditionalDependencies>
		</Link>
	</ItemDefinitionGroup>

	<ItemGroup>
		<ClCompile Include="Main.cpp" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\FlexCore.vcxproj">
			<Project>{09E204DC-F3FB-49AB-8B40-00F95CE22909}</Project>
		</ProjectReference>
		<ProjectReference Include="FlexEditorCore.vcxproj">
			<Project>{8A4AF817-6CAD-42FA-A025-314B16617063}</Project>
		</ProjectReference>
	</ItemGroup>

	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
