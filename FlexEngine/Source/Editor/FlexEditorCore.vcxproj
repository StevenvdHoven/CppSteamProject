		<RootNamespace>FlexEditorCore</RootNamespace>
		<WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
	</PropertyGroup>

	<!-- FlexEditorCore.dll: the whole editor and Dear ImGui (exported, so editor plugins share one ImGui
	     context). FlexEditor.exe (FlexEditor.vcxproj, Main.cpp) only starts it. -->
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
	<Import Project="..\..\Build\FlexConfiguration.props" />
	<PropertyGroup Label="Configuration">
		<ConfigurationType>DynamicLibrary</ConfigurationType>
	</PropertyGroup>
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
	<ImportGroup Label="PropertySheets">
		<Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
		<Import Project="..\..\Build\FlexCommon.props" />
	</ImportGroup>

	<ItemDefinitionGroup>
		<ClCompile>
			<PreprocessorDefinitions>FLEX_EDITOR=1;FLEX_EDITOR_EXPORTS;IMGUI_API=__declspec(dllexport);%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<AdditionalIncludeDirectories>$(FlexRoot)Dependencies\imgui;$(FlexRoot)Dependencies\imgui\backends;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
		</ClCompile>
		<Link>
			<AdditionalDependencies>SDL3.lib;%(AdditionalDependencies)</AdditionalDependencies>
		</Link>
	</ItemDefinitionGroup>

